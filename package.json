{
  "name": "secretsweep",
  "version": "1.0.0",
  "description": "Zero-dependency secret and PII scanner for source trees and git diffs, with SARIF output and baseline suppression.",
  "license": "MIT",
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs",
      "default": "./src/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "secretsweep": "./bin/secretsweep.mjs"
  },
  "files": [
    "src",
    "cjs",
    "types",
    "bin",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "test": "node --test tests/",
    "test:coverage": "node --test --experimental-test-coverage tests/",
    "build:cjs": "node scripts/build-cjs.mjs",
    "check:cjs": "node scripts/build-cjs.mjs --check"
  },
  "dependencies": {},
  "devDependencies": {},
  "keywords": [
    "secrets",
    "secret-scanner",
    "pii",
    "security",
    "sarif",
    "git-diff",
    "baseline",
    "zero-dependency",
    "ci",
    "static-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/secretsweep.git"
  },
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/secretsweep/issues"
  },
  "homepage": "https://github.com/draarivpatel-ui/secretsweep#readme"
}
